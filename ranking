<!DOCTYPE html>
<html lang="ja">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>▶ GRAND WAR MONITOR / ADVANCED</title>
    <link href="https://fonts.googleapis.com/css2?family=Share+Tech+Mono&family=Noto+Sans+JP:wght@400;700&display=swap" rel="stylesheet">
    <style>
        :root {
            --bg: #080b0f; --surface: #0f1318; --surface2: #161c24;
            --border: #252d3a; --border2: #1e2736; --text: #c8d8e8; --muted: #4a5568;
            --accent: #3b82f6; --attack: #ff4d4d; --defense: #22c55e;
            --battle: #eab308; --mono: 'Share Tech Mono', monospace;
        }
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body { background: var(--bg); color: var(--text); font-family: 'Noto Sans JP', sans-serif; font-size: 13px; }

        header { background: var(--surface); border-bottom: 1px solid var(--border); padding: 16px; }
        h1 { font-family: var(--mono); font-size: 14px; color: var(--accent); text-align: center; margin-bottom: 15px; }

        /* 入力エリア */
        .search-box { display: flex; gap: 8px; justify-content: center; margin-bottom: 15px; }
        input { background: var(--surface2); border: 1px solid var(--border); color: var(--text); padding: 8px; border-radius: 4px; width: 120px; font-family: var(--mono); }
        .btn-fetch { background: var(--accent); color: white; border: none; padding: 8px 16px; border-radius: 4px; cursor: pointer; font-weight: bold; }

        /* タブメニュー */
        .tabs { display: flex; background: var(--surface2); border-bottom: 1px solid var(--border); }
        .tab { flex: 1; padding: 12px; text-align: center; cursor: pointer; font-family: var(--mono); color: var(--muted); border-bottom: 2px solid transparent; transition: 0.3s; }
        .tab.active { color: var(--accent); border-bottom: 2px solid var(--accent); background: rgba(59, 130, 246, 0.05); }

        .content-panel { display: none; padding: 15px; }
        .content-panel.active { display: block; }

        /* ギルドグリッド */
        .guild-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(180px, 1fr)); gap: 10px; }
        .guild-card { 
            background: var(--surface2); border: 1px solid var(--border); padding: 12px; border-radius: 4px;
            cursor: pointer; transition: 0.2s; position: relative; overflow: hidden;
        }
        .guild-card:hover { border-color: var(--accent); background: #1c2533; }
        .guild-rank { font-family: var(--mono); font-size: 10px; color: var(--muted); margin-bottom: 4px; }
        .guild-name { font-weight: bold; color: var(--text); font-size: 13px; }
        .guild-power { font-family: var(--mono); color: var(--battle); font-size: 11px; margin-top: 4px; }

        /* プレイヤーリスト（テーブル） */
        .player-table { width: 100%; border-collapse: collapse; font-family: var(--mono); }
        .player-table th { text-align: left; color: var(--muted); font-size: 11px; padding: 8px; border-bottom: 1px solid var(--border); }
        .player-table td { padding: 10px 8px; border-bottom: 1px solid var(--border2); }
        .p-rank { color: var(--accent); width: 40px; }
        .p-name { color: var(--text); font-weight: bold; }
        .p-lv { color: var(--muted); width: 50px; }
        .p-power { color: var(--battle); text-align: right; }

        .empty-msg { text-align: center; color: var(--muted); padding: 40px; }
    </style>
</head>
<body>

<header>
    <h1>▶ WORLD GUILD ANALYZER</h1>
    <div class="search-box">
        <input type="number" id="worldInput" placeholder="WORLD ID">
        <button class="btn-fetch" onclick="runSearch()">UPDATE</button>
    </div>
</header>

<nav class="tabs">
    <div class="tab active" id="tab-guilds" onclick="switchTab('guilds')">GUILDS (48)</div>
    <div class="tab" id="tab-players" onclick="switchTab('players')">PLAYERS</div>
</nav>

<main>
    <div id="panel-guilds" class="content-panel active">
        <div class="guild-grid" id="guildList">
            <div class="empty-msg">Enter World ID and press UPDATE</div>
        </div>
    </div>

    <div id="panel-players" class="content-panel">
        <div id="playerListHeader" style="margin-bottom: 10px; font-weight: bold; color: var(--accent);"></div>
        <div id="playerContainer">
            <div class="empty-msg">Select a guild to see player rankings</div>
        </div>
    </div>
</main>

<script>
    // タブ切り替えロジック
    function switchTab(type) {
        document.querySelectorAll('.tab').forEach(t => t.classList.remove('active'));
        document.querySelectorAll('.content-panel').forEach(p => p.classList.remove('active'));
        
        document.getElementById('tab-' + type).classList.add('active');
        document.getElementById('panel-' + type).classList.add('active');
    }

    // 検索実行
    function runSearch() {
        const worldId = document.getElementById('worldInput').value;
        if(!worldId) return alert("Please enter World ID");
        
        // ギルドリスト生成 (模擬データ48個)
        const guildList = document.getElementById('guildList');
        guildList.innerHTML = '';
        
        for(let i = 1; i <= 48; i++) {
            const card = document.createElement('div');
            card.className = 'guild-card';
            const gName = `GUILD_W${worldId}_${i}`;
            const gPower = (5000 - (i * 50)).toLocaleString();
            
            card.innerHTML = `
                <div class="guild-rank">RANK ${i.toString().padStart(2, '0')}</div>
                <div class="guild-name">${gName}</div>
                <div class="guild-power">PWR: ${gPower}M</div>
            `;
            
            // タップイベント
            card.onclick = () => showPlayers(gName);
            guildList.appendChild(card);
        }
        
        switchTab('guilds');
    }

    // プレイヤーリストの表示
    function showPlayers(guildName) {
        // PLAYERSタブへ切り替え
        switchTab('players');
        
        const header = document.getElementById('playerListHeader');
        header.innerHTML = `Showing entries for: [ ${guildName} ]`;
        
        const container = document.getElementById('playerContainer');
        
        // 模擬プレイヤーデータ生成
        let html = `<table class="player-table">
            <thead>
                <tr><th>#</th><th>PLAYER</th><th>LV</th><th style="text-align:right;">POWER</th></tr>
            </thead>
            <tbody>`;
        
        for(let i = 1; i <= 20; i++) {
            const pPower = (250 - (i * 5)).toFixed(1);
            html += `
                <tr>
                    <td class="p-rank">${i}</td>
                    <td class="p-name">USER_${Math.random().toString(36).substring(7).toUpperCase()}</td>
                    <td class="p-lv">240</td>
                    <td class="p-power">${pPower}M</td>
                </tr>
            `;
        }
        
        html += `</tbody></table>`;
        container.innerHTML = html;
    }
</script>
</body>
</html>
